{
  "manifest": 1,
  "id": "codestats",
  "name": "Code Stats",
  "version": "0.0.3",
  "publisher": "hyperpane",
  "description": "Your code counted: lines of code, comments and blank lines in every language, by folder, and the longest files. Link a folder to its port to count that one.",
  "icon": "icon.svg",
  "category": "Code",
  "homepage": "https://github.com/hyperpane/hp-codestats",
  "license": "MIT",
  "engines": {
    "hyperpane": ">=0.2.2",
    "node": ">=22.15.0"
  },
  "client": {
    "main": "main.tsx"
  },
  "server": {
    "runtime": "node",
    "main": "main.ts"
  },
  "contributes": {
    "nodes": [
      {
        "kind": "codestats",
        "title": "Code Stats",
        "icon": "icon.svg",
        "size": [
          640,
          480
        ],
        "ports": [
          { "id": "path", "label": "Folder", "direction": "in", "type": "path" },
          { "id": "stats", "label": "Stats", "direction": "out", "type": "json" }
        ]
      }
    ]
  },
  "signature": {
